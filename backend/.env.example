# MySQL is the primary database. Put the local MySQL application user's password here only in your ignored .env file.
DATABASE_URL=mysql+pymysql://biosentry_app:CHANGE_ME@127.0.0.1:3306/biosentry?charset=utf8mb4
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
